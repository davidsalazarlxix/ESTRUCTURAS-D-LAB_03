# Actividades de Recursividad

# 1.1 Division usando restas
def division(a, b):
    if b > a:
        return 0
    return division(a - b, b) + 1

# 1.2 Sumar digitos de un numero
def sumar_dig(n):
    if n == 0:
        return 0
    return sumar_dig(n // 10) + n % 10

# 1.3 Invertir numero
def invertir(n, aux=0):
    if n == 0:
        return aux
    return invertir(n // 10, aux * 10 + n % 10)

# 1.4 Multiplicacion rusa
def mult_rusa(a, b):
    if a == 0:
        return 0
    if a == 1:
        return b
    if a % 2 != 0:
        return b + mult_rusa(a // 2, b * 2)
    return mult_rusa(a // 2, b * 2)

# 1.5 Suma de elementos de un arreglo
def suma_vec(v, n):
    if n == 0:
        return v[0]
    return suma_vec(v, n - 1) + v[n]

# 1.6 Multiplicar elementos de un arreglo
def multiplicar(v, n):
    if n == 0:
        return v[0]
    return v[n] * multiplicar(v, n - 1)

# 1.7 MCD
def sacar_mcd(a, b):
    if b == 0:
        return a
    return sacar_mcd(b, a % b)

# 1.8 Positivo o negativo
def positivo(n):
    if n < 0:
        return False
    return not negativo(n)

def negativo(n):
    if n >= 0:
        return False
    return not positivo(n)

# 1.9 Par o impar con recursividad cruzada
def par(n):
    if n == 0:
        return True
    return impar(n - 1)

def impar(n):
    if n == 0:
        return False
    return par(n - 1)

# 1.10 Suma de matriz
def suma_matriz(f, c, n, mat):
    if f == 0 and c == 0:
        return mat[0][0]
    if c < 0:
        return suma_matriz(f - 1, n - 1, n, mat)
    return mat[f][c] + suma_matriz(f, c - 1, n, mat)

# 1.11 Menor de un vector
def menor_vec(v, n):
    if n == 0:
        return v[0]
    m = menor_vec(v, n - 1)
    if v[n] < m:
        return v[n]
    return m

# 1.12 Mayor de un vector
def mayor_vec(v, n):
    if n == 0:
        return v[0]
    m = mayor_vec(v, n - 1)
    if v[n] > m:
        return v[n]
    return m
